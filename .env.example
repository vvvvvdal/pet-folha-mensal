# Bloqueio de acesso casual ao painel de configurações locais.
# Gere os valores sem registrá-los no Git:
# printf %s 'UMA_FRASE_LONGA_E_EXCLUSIVA' | sha256sum
# openssl rand -hex 32

ADMIN_PIN_HASH=
ADMIN_SESSION_SECRET=

# Login com Google e cópia no Drive (cliente OAuth "Aplicativo da Web" no Google Cloud).
# Redirecionamento autorizado: https://SEU_DOMINIO/api/google/callback
# GOOGLE_SESSION_SECRET criptografa o cookie de sessão; use pelo menos 32 bytes:
# openssl rand -hex 32

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SESSION_SECRET=
